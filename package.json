{
  "name": "@microck/sandbox-sdk-workssh",
  "version": "0.1.0",
  "description": "WorkSSH Codex Cloud provider for Sandbox SDK and Raft executable plugins",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "workssh-raft": "dist/raft.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/guest.py dist/guest.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencoredev/sandbox-sdk": "1.0.3",
    "@types/node": "22.19.0",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2",
    "oxlint": "1.93.0",
    "@oxlint/plugins": "1.93.0"
  },
  "peerDependencies": {
    "@opencoredev/sandbox-sdk": "1.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microck/sandbox-sdk-workssh.git"
  }
}
